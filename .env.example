# Для отдельного сервера PostgreSQL. Быстрый режим npm start создаёт .env самостоятельно.
DATABASE_URL=postgresql://taskboard:CHANGE_ME@127.0.0.1:5432/taskboard
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
PORT=4174
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=REPLACE_WITH_ANOTHER_PASSWORD
